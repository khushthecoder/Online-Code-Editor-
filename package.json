{
  "name": "compilex-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CompileX Monorepo Root Controller",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --if-present",

    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "deploy:db": "npm run deploy --workspace=server",
    
    "build": "npm run install:all && npm run build:server && npm run deploy:db && npm run build:client",
    
    "start": "npm start --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server"
  },
  "dependencies": {},
  "devDependencies": {}
}