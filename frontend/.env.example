# ── Frontend build-time environment (Vite) ──────────────────────────────────
# Copy to .env for local dev. These are inlined at BUILD time, so in production
# they must be set in the Vercel project's Environment Variables, and a redeploy
# is required after changing them.
#
# Point BOTH at the BACKEND origin (Render) — NOT the Vercel frontend origin.
# If left UNSET in production, the app falls back to same-origin, which is WRONG
# when the frontend (Vercel) and backend (Render) are on different domains.
#   Prod example: VITE_API_URL=https://compilex-backend.onrender.com

# REST API base. Local dev: http://localhost:5001
VITE_API_URL=http://localhost:5001

# Socket.IO + Yjs collab WebSocket endpoint (same backend origin as above).
VITE_SOCKET_URL=http://localhost:5001
