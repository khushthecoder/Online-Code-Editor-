# ── Backend environment (copy to .env and fill in real values) ─────────────
# NEVER commit the real .env. This file documents the required variables only.

# Postgres connection string.
#  - Local dev (Docker):   postgresql://compilex:compilex@localhost:5434/compilex?schema=public
#  - Supabase (serverless): use the TRANSACTION pooler on port 6543 with pgbouncer:
#    postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Direct (non-pooled/session) connection. The Prisma datasource now references it
# (directUrl), so `prisma migrate deploy` uses it instead of the pooled DATABASE_URL.
#  - Supabase: the 5432 SESSION-mode URL (NOT the 6543 transaction pooler).
#  - Plain/managed Postgres (incl. local Docker): set it to the SAME value as DATABASE_URL.
# Note: `prisma generate` and the runtime client do NOT require this — only migrations do.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

PORT=5001
NODE_ENV=development

# ── Horizontal scaling (optional) ────────────────────────────────────────────
# Set REDIS_URL to run MULTIPLE backend instances that share room state (Yjs
# updates + awareness + Socket.IO presence) via Redis pub/sub. Leave UNSET for a
# single instance (everything works exactly the same). Include auth in prod:
#   redis://:STRONG_PASSWORD@host:6379   (or rediss:// for TLS)
# REDIS_URL=redis://localhost:6379

# 256-bit random string: `openssl rand -hex 32`. Server refuses to boot if < 32 chars.
JWT_SECRET="change-me-openssl-rand-hex-32"

# Comma-separated list of allowed browser origins for CORS (no trailing slash).
# e.g. https://your-frontend.vercel.app,https://www.yourdomain.com
CLIENT_ORIGINS="http://localhost:5173"

# Where the backend redirects the browser after a successful OAuth login.
CLIENT_URL="http://localhost:5173"

# Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client).
# Authorized redirect URI must be <backend-origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Code execution ──────────────────────────────────────────────────────────
# Provider: "judge0" (RapidAPI Judge0 CE, recommended) or "piston".
EXEC_PROVIDER="judge0"
# Shared RapidAPI key (one key works across your subscribed RapidAPI listings).
RAPIDAPI_KEY=""
# Judge0 CE host — standard value; override only if your listing differs.
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# Piston fallback (only used when EXEC_PROVIDER=piston):
#   PISTON_API_HOST  exact X-RapidAPI-Host of a Piston listing (RapidAPI proxy), or
#   PISTON_API_URL   full /execute URL of a self-hosted Piston instance.
# PISTON_API_KEY=""
# PISTON_API_HOST=""
# PISTON_API_URL=""

# ── Real-time voice (WebRTC mesh) ────────────────────────────────────────────
# Max participants per room's voice channel (mesh guardrail; past ~6 use an SFU).
VOICE_MAX_PEERS=6
# TURN relay for NAT traversal. Leave ALL three unset to run STUN-only (works on a
# LAN / open NATs; corporate & symmetric NATs need TURN). To enable a self-hosted
# coturn (see turnserver.conf + docker-compose `coturn`):
#   TURN_SECRET must equal coturn's static-auth-secret.
#   TURN_URLS is a comma-separated list of relay URLs (udp + tcp recommended).
# TURN_SECRET="same-as-coturn-static-auth-secret"
# TURN_URLS="turn:your.public.host:3478?transport=udp,turn:your.public.host:3478?transport=tcp"
# TURN_TTL_SECONDS=3600
#
# ── Voice at scale: LiveKit SFU (optional) ───────────────────────────────────
# Set ALL THREE to switch voice from the built-in mesh to a LiveKit SFU (large
# rooms, server-side active-speaker, mobile-grade reconnection). The client learns
# the mode from GET /api/voice/config — no frontend changes needed. Leave unset
# for mesh mode. Use LiveKit Cloud (free tier) or self-host (docker-compose livekit
# + livekit.yaml). Secret must match livekit.yaml's key.
# LIVEKIT_URL="ws://localhost:7880"            # wss://<your-project>.livekit.cloud in prod
# LIVEKIT_API_KEY="devkey"
# LIVEKIT_API_SECRET="devsecret_change_me_min_32_chars_long_00"

# AI providers (at least one required for the AI Copilot feature).
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
OPENAI_API_KEY=""
