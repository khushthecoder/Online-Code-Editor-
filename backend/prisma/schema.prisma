// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime/pooled connection (e.g. Supabase transaction pooler on :6543).
  url       = env("DATABASE_URL")
  // Direct (session) connection used ONLY by `prisma migrate deploy`. On a plain
  // Postgres, set DIRECT_URL to the same value as DATABASE_URL. Prisma resolves it
  // lazily — `prisma generate` and the runtime client don't require it to be set.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  email     String    @unique
  password  String?   
  googleId  String?   @unique
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Room {
  id        String   @id @default(cuid())
  roomId    String   @unique 
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  code      Code?
  createdAt DateTime @default(now())
}
model Code {
  id        String   @id @default(cuid())
  html      String?  @default("")
  css       String?  @default("")
  javascript String? @default("")
  python    String?  @default("")
  room      Room     @relation(fields: [roomId], references: [id])
  roomId    String   @unique
  updatedAt DateTime @updatedAt
}

// Binary Yjs (CRDT) document state, one per room. Source of truth for live
// collaborative editing. Additive — the legacy Code table is left intact and
// used only to seed a room's CRDT doc the first time it loads.
model CollabDoc {
  roomId    String   @id
  state     Bytes
  updatedAt DateTime @updatedAt
}

// Version history — a named checkpoint of a room's full CRDT state, with who
// saved it and when. Restore applies this state back onto the live document.
model Snapshot {
  id        String   @id @default(cuid())
  roomId    String
  label     String?
  author    String?
  state     Bytes
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}